# Rust
/sim_core/target/
# NOTE: Cargo.lock IS committed — this is an application, not a library.
# Reproducible builds matter more than letting downstream pick versions.
**/*.rs.bk

# Godot
.godot/
.import/
*.translation
export.cfg
export_presets.cfg
.tmp/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml
.cursor/
.zed/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Build artifacts
/build/
/dist/
*.so
*.dll
*.dylib
*.pdb

# Built GDExtension libraries ARE checked in for now so the Godot project opens
# cleanly on every platform without requiring users to install a Rust toolchain.
# When binaries get too heavy we'll switch to CI artifacts. Local rebuilds:
# `tools/build_gdext.sh` (Linux/macOS) or cross-compile via mingw for Windows.
!/godot_project/addons/babel_gd/lib/*.so
!/godot_project/addons/babel_gd/lib/*.dll
!/godot_project/addons/babel_gd/lib/*.dylib

# Logs / dumps
*.log
saves/
exports/
profiling/

# Tooling
.coverage
coverage.xml
htmlcov/
