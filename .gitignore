# Rust
/sim_core/target/
# NOTE: Cargo.lock IS committed — this is an application, not a library.
# Reproducible builds matter more than letting downstream pick versions.
**/*.rs.bk

# Godot
.godot/
.import/
*.translation
export.cfg
export_presets.cfg
.tmp/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

