# Build artifacts
/build/
/dist/
*.so
*.dll
*.dylib
*.pdb

# Built GDExtension libraries are NOT checked in. They are produced by
# `tools/build_gdext.sh` locally or by the `build_gdext` CI job (uploaded as
# an artifact). Run the build script before opening the Godot project.
/godot_project/addons/babel_gd/lib/*.so
/godot_project/addons/babel_gd/lib/*.dll
/godot_project/addons/babel_gd/lib/*.dylib

